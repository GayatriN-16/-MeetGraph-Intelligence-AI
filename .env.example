# Server Port
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this application is hosted.
APP_URL="http://localhost:3000"

# GOOGLE OAUTH 2.0 & GOOGLE MEET REST API v2
# Obtain these from Google Cloud Console (https://console.cloud.google.com/) -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Token Encryption Key: 32-character secret string used for AES-256-GCM encrypted token persistence
TOKEN_ENCRYPTION_KEY="your-random-32-byte-hex-secret-key"

# Murf AI Speech-to-Text WebSocket API Key
# Obtain from Murf AI Console (https://murf.ai/)
MURF_API_KEY="your-murf-api-key"

# ElevenLabs Speech-to-Text (Scribe API) Key
# Obtain from ElevenLabs Dashboard (https://elevenlabs.io/)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Google Meet Webhook secret for Pub/Sub notifications validation
GOOGLE_WEBHOOK_SECRET="your-google-meet-webhook-secret"
